# Copy to .env.local (gitignored) for local development:  cp .env.example .env.local
GEMINI_API_KEY=YOUR_NEW_PRIVATE_GEMINI_KEY
# Optional
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest   # used if the main model is overloaded; empty to disable
# PORT=8787
# ASCEND_ACCESS_CODE=choose-a-code   # if set, the app must send this code (Coach settings)
