{
  "name": "saturday-26",
  "private": true,
  "version": "0.1.0",
  "description": "SATURDAY 26 \u2014 college football head-coach dynasty simulation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simtest": "tsx scripts/simulateMany.ts",
    "sim:game": "tsx scripts/oneGame.ts",
    "sim:season": "tsx scripts/simulateSeason.ts",
    "e2e": "node scripts/e2e/smoke.mjs && node scripts/e2e/decision.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}